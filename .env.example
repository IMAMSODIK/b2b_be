APP_NAME=Digital Signage API
APP_ENV=prod
DATABASE_URL=postgresql+psycopg://signage:signage_pass@localhost:5432/signage
JWT_SECRET=change_me
JWT_ALG=HS256
ADMIN_JWT_MINUTES=60
DEVICE_TOKEN_DAYS=30
PAIRING_CODE_TTL_MINUTES=10
ASSET_SIGNING_KEY=change_me_signing_key
ASSET_SIGNING_KID=v1
ASSET_ROOT=storage/assets
PUBLIC_API_BASE=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=120
